# MX1 AI Gateway — ضع القيم في Cloudflare Secrets أو بيئة الخادم، ولا ترفع ملف .env الحقيقي
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta AI: استخدم endpoint رسميًا متاحًا لحسابك فقط؛ لا نضع رابطًا مفترضًا
META_AI_API_URL=
META_AI_API_KEY=

# AI Agent/Webhook اختياري
AI_AGENT_WEBHOOK_URL=
AI_AGENT_WEBHOOK_TOKEN=

# بقية إعدادات MX1
MONGODB_URI=
JWT_SECRET=
PORT=5000
